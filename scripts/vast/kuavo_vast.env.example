# Copy this file outside the repository, fill it, then run:
#   chmod 600 /path/to/private.env
# Never commit the private copy.

export HF_TOKEN="<hf-token>"
export DATASET_REPO="<owner/private-dataset>"
export MODEL_REPO="<owner/output-model>"
export MODEL_REPO_PRIVATE="1"

export WANDB_API_KEY="<wandb-key>"
export WANDB_PROJECT="kuavo-training"
export SERVERCHAN_SENDKEY="<serverchan-sendkey>"

export VAST_INSTANCE_ID="<instance-id>"
export VAST_API_KEY="<vast-api-key>"
export AUTO_STOP_INSTANCE="1"
export AUTO_STOP_ON_FAILURE="0"
export AUTO_STOP_ON_UPLOAD_FAILURE="0"

export GPU_IDS="0"
export GPU_COUNT="1"
export RUN_ID="<unique-run-id>"
# DP / ACT install requirements_train_cloud.txt by default.
export PREPARE_ENV="1"

# One instance runs exactly one task + algorithm, selected by launch_job.sh.
# Resume is optional and is passed on the command line:
#   --resume-repo owner/full-checkpoint-repo --resume-run-id run_...
# The resume repository must contain the full trainer state, not only inference
# weights. OpenPI may read RESUME_REPO and upload the continued run to MODEL_REPO.

# DP / ACT
# export TRAIN_CONFIG_NAME="dp_r1.yaml"
# export TASK_NAME="r1"
# export TRAIN_BATCH_SIZE="32"
# export GRAD_ACCUM_STEPS="1"
# export TRAIN_MAX_STEPS="30000"
# GPU_COUNT > 1 automatically uses Accelerate for DP / ACT.

# OpenPI
# export ROBOT_TASK="task1"
# export PIPELINE_MODE="train"
# export CONFIRM_FULL_TRAIN="YES"
# export BASE_PARAMS="gs://openpi-assets/checkpoints/pi05_base/params"

# LingBot-v1 model locations are downloaded by the delegated pipeline.
# export LINGBOT_MODEL_REPO="robbyant/lingbot-vla-4b"
# export QWEN_MODEL_REPO="Qwen/Qwen2.5-VL-3B-Instruct"

# LingBot-v2 defaults include base weights plus bundled Depth/DINO assets.
# export LINGBOT_V2_MODEL_REPO="robbyant/lingbot-vla-v2-6b"
# export QWEN3_MODEL_REPO="Qwen/Qwen3-VL-4B-Instruct"
# export MOGE_MODEL_REPO="Ruicheng/moge-2-vitb-normal"
