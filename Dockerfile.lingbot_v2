# syntax=docker/dockerfile:1.7

ARG CLASSIC_BASE_IMAGE=kuavo-classic:latest
FROM ${CLASSIC_BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG PIP_INDEX_URL=https://mirrors.bfsu.edu.cn/pypi/web/simple

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/opt/kuavo-env/bin:${PATH} \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=0 \
    LINGBOT_V2_ROOT=/root/kuavo_data_challenge/third_party/lingbot-vla-v2 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

WORKDIR /root/kuavo_data_challenge

# Create this archive from the upstream Python 3.12 / PyTorch 2.8 environment.
COPY --from=lingbot_v2_env /myenv.tar.gz /tmp/myenv.tar.gz
RUN mkdir -p /opt/kuavo-env && \
    tar -xzf /tmp/myenv.tar.gz -C /opt/kuavo-env && \
    rm -f /tmp/myenv.tar.gz && \
    /opt/kuavo-env/bin/conda-unpack

COPY . .

RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/kuavo-env/bin/python -m pip install -e . --no-deps --root-user-action=ignore && \
    /opt/kuavo-env/bin/python -m pip install -r requirements_policy_client.txt --root-user-action=ignore && \
    /opt/kuavo-env/bin/python -m pip install -e ./third_party/lingbot-vla-v2 --no-deps --root-user-action=ignore && \
    /opt/kuavo-env/bin/python -c "import torch, transformers, websockets; assert torch.__version__.startswith('2.8.'); print(torch.__version__, transformers.__version__, websockets.__version__)" && \
    bash -lc 'source /opt/ros/noetic/setup.bash && source myenv/bin/activate && python -c "import rospy; from kuavo_deploy.kuavo_env.KuavoBaseRosEnv import KuavoBaseRosEnv; print(\"LingBot-v2 ROS client imports: OK\")"'

ENTRYPOINT ["/opt/kuavo-env/bin/python", "tools/policy_worker.py"]
CMD ["--help"]
