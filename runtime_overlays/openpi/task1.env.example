# Docker image already loaded from the base/release TAR.
IMAGE_NAME=kdc_real_task1_openpi:latest
CONTAINER_NAME=kuavo-openpi-task1-runtime

# Point to the OpenPI step directory containing params/_METADATA.
CHECKPOINT_DIR=/mnt/pqssd/hf_train_outputs/task1_pi05_60000/14999
TOKENIZER_FILE=/mnt/pqssd/pretrained/google/paligemma-3b-pt-224/tokenizer.model

# May be inside CHECKPOINT_DIR or a completely separate file.
NORM_STATS_FILE=/mnt/pqssd/hf_train_outputs/task1_pi05_60000/14999/assets/kuavo_task1_mix_db94f091e2/norm_stats.json
OPENPI_ASSET_ID=kuavo_task1_mix_db94f091e2

DEPLOY_CONFIG=runtime_overlays/openpi/kuavo_env.task1.yaml
EXECUTE_STEPS=5

ROS_MASTER_URI=http://kuavo_master:11311
ROS_IP=192.168.26.10
