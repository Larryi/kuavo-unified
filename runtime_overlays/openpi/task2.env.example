# Either OpenPI release image can be reused because runtime assets are overlaid.
IMAGE_NAME=kdc_real_task2_openpi:latest
CONTAINER_NAME=kuavo-openpi-task2-runtime

# Point to the OpenPI step directory containing params/_METADATA.
CHECKPOINT_DIR=/mnt/pqssd/hf_train_outputs/task2_pi05/49999
TOKENIZER_FILE=/mnt/pqssd/pretrained/google/paligemma-3b-pt-224/tokenizer.model

# This example reflects the dynamic mixed-dataset asset ID reported by the checkpoint.
NORM_STATS_FILE=/mnt/pqssd/hf_train_outputs/task2_pi05/49999/assets/kuavo_task2_mix_2c74a207c5/norm_stats.json
OPENPI_ASSET_ID=kuavo_task2_mix_2c74a207c5

DEPLOY_CONFIG=runtime_overlays/openpi/kuavo_env.task2.yaml
EXECUTE_STEPS=5

ROS_MASTER_URI=http://kuavo_master:11311
ROS_IP=192.168.26.10
